menu "wakelanaka-airlog Node Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default ""

    config WIFI_PASSWORD
        string "WiFi Password"
        default ""

    config MQTT_BROKER_URI
        string "MQTT Broker URI"
        default "mqtt://192.168.1.1:1883"

    config MQTT_USERNAME
        string "MQTT Username"
        default "air-nodes"

    config MQTT_PASSWORD
        string "MQTT Password"
        default ""

    config NODE_ROOM
        string "Room this node is placed in (e.g. living_room)"
        default ""

    config SNTP_SERVER
        string "SNTP server for time sync"
        default "pool.ntp.org"

    config NODE_DEVELOPMENT_MODE
        bool "Enable development mode (verbose logging)"
        default n

endmenu
